# Public base URL of the PocketBase instance used by Visura AI.
NEXT_PUBLIC_POCKETBASE_URL=https://your-pocketbase.example

# Public phone number shown in the mobile action bar.
NEXT_PUBLIC_PHONE_NUMBER=+393331234567

# Public email address used by contact actions.
NEXT_PUBLIC_CONTACT_EMAIL=contatto@example.com

# Privacy notice: public controller details, embedded at build time.
NEXT_PUBLIC_PRIVACY_CONTROLLER_NAME="Nome Cognome"
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com

# Role shown across the site, metadata, structured data, and email templates.
# Set before building/exporting; rebuild and redeploy after changing it.
NEXT_PUBLIC_SITE_ROLE=Senior Full-Stack Developer

# Optional comma-separated hostnames or IPs allowed to access development assets.
NEXT_DEV_ALLOWED_ORIGINS=
